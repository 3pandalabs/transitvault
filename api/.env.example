# TransitVault API. Copy to .env for local dev. NEVER commit real values.

# Postgres. Prod: internal connection string for the `transitvault` database on
# the shared 3pandalabs-postgres instance, as the `transitvault_app` role (which
# owns the database). Local: docker-compose.dev.yml (port 5438).
DATABASE_URL=postgres://transitvault:transitvault@localhost:5438/transitvault
# Do NOT set MIGRATION_DATABASE_URL: there is no role split (42501 gotcha).

PORT=8080

# Access-token signing secret. openssl rand -hex 32
JWT_SECRET=

# The web app's origin: CORS allow-list and links in emails.
WEB_ORIGIN=http://localhost:3000
# This API's public origin, for email links through /go/assist/:iata (default: production).
PUBLIC_API_URL=http://localhost:8080
# Optional extra comma-separated CORS origins (previews).
CORS_ORIGINS=
# Shared secret the web Worker sends as X-Internal-Secret on api-internal calls.
INTERNAL_SHARED_SECRET=


# Mail. SMTP (Gmail app password) first, the org gateway as fallback; both optional.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAILER_URL=https://mailer.3pandalabs.com
MAILER_TOKEN=
EMAIL_FROM_NAME=TransitVault
# Where user reports are emailed (default support@3pandalabs.com).
OPS_EMAIL=

# Ops-only GET /metrics bearer token (shared across org apps). Blank -> 503.
METRICS_TOKEN=

# Paid help (api/ROUTES.md "Paid help"). OFF unless PAYMENTS_ENABLED=true AND
# both Stripe values are set; otherwise the app is the free board as before.
# Use test keys (sk_test_..., whsec_... from `stripe listen`) locally.
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Local mocks only; leave unset in production.
# STRIPE_API_BASE=http://localhost:12111
# Bearer token for ops-only routes (POST /ops/acceptances/:id/card-refund). Blank -> 503.
OPS_TOKEN=

